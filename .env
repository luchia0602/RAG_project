# Copy this file to .env and add your own API key.
GOOGLE_API_KEY=your_gemini_api_key_here

# Input PDF (relative to the repository root, or an absolute path)
PDF_PATH=data/Core Rules.pdf

# Models
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
GENERATION_MODELS=gemini-3.8-flash,gemini-3.6-flash

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval
INITIAL_K=15
TOP_K=5
SCORE_MARGIN=0.25
